APP_NAME="AFG Academie"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Public URL of THIS API (used for storage URLs, signed routes, etc.)
APP_URL=http://localhost:8000

# French is the academy's working language. Validation messages ship in fr.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL / MariaDB — Hostinger compatible) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afg_academy
DB_USERNAME=root
DB_PASSWORD=
# Optional: path to an SSL CA bundle if your MySQL host requires TLS.
# MYSQL_ATTR_SSL_CA=

# Stateless token API — no server-side HTTP sessions needed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Emails are pushed onto the database queue. (Jitsi rooms are built inline.)
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (SMTP — Hostinger mail or any provider) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="contact@afg-academie.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================ AFG specific ============================

# CORS / frontend origin(s). Comma-separated list of allowed SPA origins.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Mailbox that receives chatbot "contacter un conseiller" requests.
AFG_CONTACT_NOTIFY_EMAIL=contact@afg-academie.com

# --- Visioconférence — Jitsi Meet ---
# POST /api/sessions/{id}/meeting builds a room URL on this server. No API
# credentials needed. Use the public server or your self-hosted instance.
JITSI_SERVER=https://meet.jit.si

# --- AWS / S3 (optional, not used by default) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
